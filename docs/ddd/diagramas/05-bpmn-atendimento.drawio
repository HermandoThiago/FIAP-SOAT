        <mxCell id="bpmn-limit" value="Baixa e FINALIZADA são atômicas; as caixas separam responsabilidades, não commits. Sem reparo adicional, agenda de mecânicos ou cancelamento pós-aprovação." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;spacing=12;shadow=0;fillColor=none;strokeColor=none;rounded=0;align=left;spacing=0;" vertex="1" parent="1">
