        <mxCell id="identity" value="Identidade e acesso • identity&lt;br&gt;Subdomínio genérico&lt;br&gt;&lt;br&gt;Usuários, perfis, login JWT, refresh e token de acompanhamento&lt;br&gt;Usuário Cliente também é um Usuario com perfil Cliente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#0f172a;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;spacing=12;shadow=0;fontStyle=1;" vertex="1" parent="1">
