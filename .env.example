# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# PRISMA ORM
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# DATABASE ENVS
POSTGRES_USER=<"YOUR DATABASE USER">
POSTGRES_PASSWORD=<"YOUR DATABASE PASSWORD">
POSTGRES_DATABASE_NAME=<"YOUR DATABASE NAME">

# APP
SEED_PASSWORD=<"YOUR STANDART PASSWORD FOR HASHING">

# AUTH
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=<"YOUR RANDOM SECRET">
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
