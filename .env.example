# Copie para .env — todos os valores abaixo são fictícios (nunca versione o .env).
# Ambiente: dev habilita Swagger (/docs), seed de demonstração e logs legíveis; test | prod
APP_ENV=dev
PORT=8080
LOG_LEVEL=info

# PostgreSQL 16 (ADR-002). Fora do Docker aponte para localhost; no compose o host é `postgres`.
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina
DATABASE_URL=postgresql://oficina:oficina@localhost:5432/oficina

# JWT HS256 (ADR-004): segredo com pelo menos 32 caracteres; expiração em minutos.
JWT_SECRET=change-me-dev-secret-with-at-least-32-chars
JWT_EXPIRES_MIN=60

# Usuário MANAGER criado na subida (RF-062) e senha dos demais usuários do seed de demonstração.
ADMIN_EMAIL=manager@oficina.local
ADMIN_PASSWORD=change-me-manager
SEED_PASSWORD=change-me-demo
