# Copie para `.env` (`cp .env.example .env`). Todos os valores abaixo são FICTÍCIOS e só servem para
# desenvolvimento/demonstração local: troque-os em qualquer outro ambiente. Nunca commite o `.env`.

# --- Banco (PostgreSQL 16) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DATABASE_NAME=fiap
# Porta do PostgreSQL publicada no host (mude se a 5432 já estiver em uso).
POSTGRES_PORT=5432
# Usada fora do Docker (npm run start:dev, prisma migrate dev, testes). No `docker compose` ela é
# montada automaticamente apontando para o serviço `database`.
DATABASE_URL="postgresql://admin:admin@localhost:5432/fiap"

# --- Seed de demonstração ---
# Senha dos 4 usuários criados pelo seed (admin, atendente, mecânico e cliente @oficina.local).
SEED_PASSWORD=Demo@Oficina2026

# --- Autenticação (ADR-004) ---
# Mínimo 32 caracteres. Em outro ambiente gere com: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789-abcdefghijklmnop
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Acompanhamento do cliente (token de acompanhamento, ADR-011) ---
TRACKING_TOKEN_EXPIRES_IN=7d
TRACKING_BASE_URL=http://localhost:3001

# --- API ---
# Porta publicada no host pelo docker compose (a API escuta em 3001 dentro do contêiner).
API_PORT=3001
