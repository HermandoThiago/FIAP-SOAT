{
  "name": "oficina-api",
  "version": "0.1.0",
  "description": "Sistema de Gestão da Oficina — back-end monolítico (FIAP Pós Tech SOAT, Tech Challenge Fase 1, grupo 49)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:bdd": "cucumber-js",
    "test:e2e": "npm run test:integration && npm run test:bdd",
    "test:cov": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "openapi:export": "ts-node scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "dependency-cruiser": "18.4.0",
    "dotenv": "18.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
